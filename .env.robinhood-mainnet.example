# Robinhood Chain MAINNET (chain 4663), stage A: closed launch, USDG quote, owned by a Safe.
# Copy to .env.robinhood-mainnet (git-ignored) and load it ONLY in the shell you deploy from:
#   set -a; source .env.robinhood-mainnet; set +a
# Never put the mainnet key in .env (that file holds the testnet key). Never paste keys in chat.

# --- keys (fresh, never reused from testnet) ---
PRIVATE_KEY=                      # deployer; generate with `cast wallet new`; fund ~0.01 ETH on Robinhood Chain
KEEPER=                           # keeper bot ADDRESS (its private key goes to Railway only); fund ~0.005 ETH
MULTISIG=                         # the Safe on Robinhood Chain (app.safe.global -> "Robinhood Chain"); MUST be a contract
PROTOCOL_RECIPIENT=               # where the protocol fee share goes; start with the Safe, move to RadianTreasuryERC20 in 5f.4
WHITELIST_LAUNCHER=               # the wallet allowed to launch while launches are closed (deployer or your own wallet)

# --- chain ---
RPC=https://rpc.mainnet.chain.robinhood.com
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951      # canonical Uniswap V4 (verified on-chain 2026-09-16)
POSITION_MANAGER=0x58daec3116aae6d93017baaea7749052e8a04fa7  # canonical Uniswap V4 PositionManager
# PERMIT2 defaults to the canonical 0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- launch policy (business decisions; the ETH values mirror the 4,000 / 10,000 USDG shape at ~$4k/ETH) ---
ENABLE_LAUNCH=false               # stage A: closed; only WHITELIST_LAUNCHER can launch
DEPLOY_STANDINS=false             # mainnet: no mock dollar / stock tokens
LAUNCH_FEE_WEI=100000000000000    # 0.0001 ETH
PHANTOM_WEI=1000000000000000000   # 1 ETH opening virtual reserve for ETH-quoted curves
GRADUATION_WEI=2500000000000000000 # 2.5 ETH graduates an ETH-quoted curve

# --- USDG, the dollar quote (Global Dollar, 6 decimals) ---
QUOTE_TOKEN=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
QUOTE_DECIMALS=6
QUOTE_PHANTOM_RAW=4000000000      # 4,000 USDG
QUOTE_GRADUATION_RAW=10000000000  # 10,000 USDG

# Stock tokens (NVDA 0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC, ...) are NOT approved in stage A:
# they wait for the legal opinion (see MAINNET_RUNBOOK.md 5f).
