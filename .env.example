# ── Testnet (current) — keep in `.env` ──
# Deployer key funded with Arc testnet USDC (faucet: https://faucet.circle.com)
PRIVATE_KEY=
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# ── Mainnet (Arc, chain 5042, public launch 2026-09-16) — keep in `.env.mainnet`, NOT here ──
# A FRESH key, never the testnet one. Source `.env.mainnet` only in the shell you deploy from,
# so the testnet PRIVATE_KEY above can never be picked up by a mainnet script.
# PRIVATE_KEY=
ARC_MAINNET_RPC=
# Canonical Uniswap V4 on Arc mainnet (Uniswap ships v4 on Arc — do NOT self-deploy).
#   PoolManager is deterministic across chains; confirm on Arcscan before use.
POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
POSITION_MANAGER=          # canonical Arc v4 PositionManager — fetch at launch (see runbook)
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
# Protocol fee recipient at deploy time. DeployRadian re-points the hook at the treasury (§5b).
PROTOCOL_RECIPIENT=
# Multisig (Gnosis Safe) that will own all six contracts after the smoke test. Must be a contract.
MULTISIG=
# Production launch economics (native USDC, whole units). Review before deploy.
LAUNCH_FEE_USDC=1
PHANTOM_USDC=4000
GRADUATION_USDC=10000

# ── Only for chains where USDC is an ERC-20, not the gas coin (Base, BSC…; see MULTICHAIN.md) ──
# QUOTE_TOKEN=
# QUOTE_DECIMALS=6
# QUOTE_PHANTOM_USDC=4000
# QUOTE_GRADUATION_USDC=10000

# ── Flywheel deploy (DeployRadian / DeployRadianFlywheel) ──
# OWNER: final owner of RadianStaking + RadianTreasury (the multisig on mainnet; two-step handover).
# KEEPER: the key allowed to call treasury.flush(minRadianOut, deadline) within the on-chain bounds.
OWNER=
KEEPER=

# ── Deployed addresses (fill from deploy output; used by TransferOwnership + VerifyOwnership) ──
FACTORY=
HOOK=
VAULT=
LOCKER=
STAKING=
TREASURY=
